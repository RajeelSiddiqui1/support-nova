# NovaWear Apparel Client Environment Template (Vercel & Local)

# 1. Backend API URL (For Vercel deployment, put your Vercel backend URL or leave empty if using same domain rewrites)
# Local: http://localhost:8000 | Vercel: https://your-backend-app.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. NextAuth & App URL
# Local: http://localhost:3000 | Vercel: https://your-frontend-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=supportnova_nextauth_secret_key_2026

# 3. Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
