# ==========================================
# SupportNova Unified .gitignore
# ==========================================

# ── Frontend / Node.js (client/) ──
client/node_modules/
node_modules/
client/.next/
.next/
client/out/
out/
client/build/
build/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Backend / Python (server/) ──
server/.venv/
server/venv/
server/env/
server/ENV/
.venv/
env/
venv/
ENV/

# Python Cache & Compiled Files
server/__pycache__/
server/*/__pycache__/
server/*/*/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.mypy_cache/
*.egg-info/
.hatch/

# Uploads & Temporary Server Storage
server/uploads/
server/temp/
server/storage/
server/logs/
*.log

# ── Environment Variables & Secrets ──
.env
.env*.local
client/.env
client/.env.local
client/.env*.local
server/.env
server/.env.local
server/.env*.local

# ── IDEs, OS & Editor Junk ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
