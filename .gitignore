# ==========================================
# SupportNova Unified .gitignore
# ==========================================

# ── Node Modules & Dependencies ──
**/node_modules/
**/node_modules/**
node_modules/
client/node_modules/
client/node_modules/**
.pnp
.pnp.js

# ── Next.js Build Outputs ──
**/.next/
**/.next/**
.next/
client/.next/
client/.next/**
out/
client/out/
build/
client/build/
*.tsbuildinfo

# ── Debug Logs ──
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Python Virtual Environments ──
**/.venv/
**/.venv/**
**/venv/
**/env/
.venv/
venv/
env/
server/.venv/
server/.venv/**
server/venv/
server/env/

# ── Python Cache & Binaries ──
**/__pycache__/
**/__pycache__/**
__pycache__/
server/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.mypy_cache/
*.egg-info/
.hatch/

# ── Uploads & Server Storage ──
server/uploads/
server/temp/
server/storage/
server/logs/

# ── Environment Secrets ──
.env
.env*
.env.local
.env*.local
client/.env
client/.env.local
client/.env*.local
server/.env
server/.env.local
server/.env*.local

# ── OS & IDE Files ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
