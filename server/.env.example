# SupportNova Environment Configuration

# Application & Deployment
HOST=0.0.0.0
PORT=8000
DEBUG=True
FRONTEND_URL=https://your-app-name.vercel.app

# MongoDB Connection (Include DB name directly in URI for Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.1cdmxhf.mongodb.net/supportnova_db?retryWrite=true&w=majority&appName=Cluster0

# Groq LLM API Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# Security / JWT
JWT_SECRET=supportnova_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / IMAP Email Integration (30-second Customer Email Polling & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_support_email@gmail.com
SMTP_PASS=your_gmail_app_password
SUPPORT_EMAIL=your_support_email@gmail.com
FROM_EMAIL=noreply@supportnova.ai
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# AWS S3 Bucket Storage (Persistent Policy PDFs & Web Form Attachments for Vercel/Cloud)
AWS_ACCESS_KEY_ID=AKIAT7HJZSB7YXZB6UEM
AWS_SECRET_ACCESS_KEY=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
AWS_REGION=ap-southeast-1
